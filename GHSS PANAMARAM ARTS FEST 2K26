 {id:14,name:"ഉപന്യാസം മലയാളം — HS",cat:"Off Stage",places:[
  ["1st","FIDA FATHIMA","BLUE • 5 points"],["2nd","ANANDAKRISHNAN VK","GREEN • 5 points"],["3rd","DILNA SAMAD","BLUE • 3 points"],["","SAJITHA","YELLOW • 3 points"],["","AMRUTHA K","BLUE • 1 point"],["","HANNA FATHIMA","RED • 1 point"],["","NIDHIN KRISHNA","YELLOW • 1 point"]]},
 {id:15,name:"കവിതാരചന ഹിന്ദി — HS",cat:"Off Stage",places:[
  ["1st","MUHAMMED SHAFIGUL S","RED • 5 points"],["2nd","ARSHAD NIZAMI","YELLOW • 1 point"],["3rd","ZAHEEN ALI","YELLOW • 1 point"]]}
];

const upcoming = [
"ചിത്രരചന എണ്ണച്ചായം — HS","ശാസ്ത്രീയ സംഗീതം ആൺ — HS","ശാസ്ത്രീയ സംഗീതം പെൺ — HS",
"കഥകളിസംഗീതം ആൺ/പെൺ","ലളിതഗാനം UP","ലളിതഗാനം HS ആൺ","ലളിതഗാനം HS പെൺ",
