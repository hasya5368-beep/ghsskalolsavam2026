const data=[...completed.map(x=>({...x,status:"done"})),...upcoming.map((name,i)=>({id:100+i,name,cat:"On/Off Stage",status:"up"}))];
const grid=document.getElementById("grid"), search=document.getElementById("search"), details=document.getElementById("details");
let filter="all";

function render(){
 const q=search.value.toLowerCase();
 grid.innerHTML="";
 data.filter(x=>(filter==="all"||x.status===filter)&&x.name.toLowerCase().includes(q)).forEach(x=>{
  const el=document.createElement("article"); el.className="card";
  el.innerHTML=`<span class="tag ${x.status==="done"?"done":"up"}">${x.status==="done"?"✅ COMPLETED":"⏳ UPCOMING"}</span>
  <h3>${x.name}</h3><p>${x.status==="done"?"Result available — tap to view":"Program name only — result not yet available"}</p>
  ${x.status==="done"?`<div class="winner"><b>${x.places[0][0]||"Result"} — ${x.places[0][1]}</b><small>${x.places[0][2]}</small></div>`:""}`;
  el.onclick=()=>showDetails(x); grid.appendChild(el);
 });
}
function showDetails(x){
 details.classList.add("show");
 if(x.status==="up"){details.innerHTML=`<h3>⏳ ${x.name}</h3><p style="color:var(--muted)">ഈ പരിപാടിയുടെ result PDF-ൽ ഇപ്പോൾ നൽകിയിട്ടില്ല. Result update ചെയ്യുമ്പോൾ ഇവിടെ names/points ചേർക്കാം.</p>`}
 else{
  details.innerHTML=`<h3>🏆 ${x.name}</h3><p style="color:var(--muted)">${x.cat}</p><div class="podium">
  ${x.places.map(p=>`<div class="person"><b>${p[0]||"Participant"} ${p[1]}</b><span>${p[2]}</span></div>`).join("")}</div>`;
 }
 details.scrollIntoView({behavior:"smooth",block:"nearest"});
}
document.querySelectorAll(".filter").forEach(b=>b.onclick=()=>{document.querySelectorAll(".filter").forEach(x=>x.classList.remove("active"));b.classList.add("active");filter=b.dataset.filter;render()});
search.oninput=render; render();
</script>
